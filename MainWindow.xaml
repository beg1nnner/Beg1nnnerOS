<Window x:Class="Beg1nnnerOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Beg1nnnerOS" Width="1360" Height="880" MinWidth="900" MinHeight="600"
        Icon="app.ico" Background="#09090C" WindowStartupLocation="CenterScreen">
    <!-- Свой заголовок окна в цветах панели: системная рамка остаётся (привязка к краям, тени, анимации), а полоса заголовка — наша -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="BarBg" Color="#09090C" />
        <SolidColorBrush x:Key="BarFg" Color="#F4F4F7" />
        <SolidColorBrush x:Key="BarMuted" Color="#9D9DAE" />
        <SolidColorBrush x:Key="BarHover" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="BarPressed" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="BarLine" Color="#12FFFFFF" />
        <SolidColorBrush x:Key="Accent" Color="#8B5CF6" />
        <SolidColorBrush x:Key="AccentSoft" Color="#2A8B5CF6" />
        <SolidColorBrush x:Key="AccentText" Color="#C4B5FD" />
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="{DynamicResource BarMuted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BarHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource BarFg}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BarPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B50F1E" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Storyboard x:Key="SplashLoading" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="LoadingSlide" Storyboard.TargetProperty="X" From="-60" To="180" Duration="0:0:1.4">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Border x:Name="Frame" Background="{DynamicResource BarBg}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- полоса заголовка -->
            <Grid x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource BarBg}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" BorderThickness="1">
                        <TextBlock Text="B1" FontFamily="Cascadia Mono, Consolas" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <!-- название уже есть в меню панели; здесь только знак и статус эфира -->
                    <Border x:Name="LiveBadge" Visibility="Collapsed" Margin="12,0,0,0" Padding="9,3,10,3" CornerRadius="999" VerticalAlignment="Center"
                            Background="#1AF43F5E" BorderBrush="#4DF43F5E" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#F43F5E" VerticalAlignment="Center" />
                            <TextBlock x:Name="LiveText" Text="В ЭФИРЕ" Margin="7,0,0,0" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#F43F5E" VerticalAlignment="Center" />
                            <TextBlock x:Name="LiveTime" Margin="7,0,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{DynamicResource BarFg}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="MinBtn" Style="{StaticResource CaptionButton}" Click="OnMinimize" ToolTip="Свернуть" AutomationProperties.Name="Свернуть">
                        <Path Data="M0,0.5 L10,0.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="1" />
                    </Button>
                    <Button x:Name="MaxBtn" Style="{StaticResource CaptionButton}" Click="OnMaximize" ToolTip="Развернуть" AutomationProperties.Name="Развернуть">
                        <Path x:Name="MaxIcon" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10" />
                    </Button>
                    <Button x:Name="CloseBtn" Style="{StaticResource CloseButton}" Click="OnCloseClick" ToolTip="Закрыть" AutomationProperties.Name="Закрыть">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10" />
                    </Button>
                </StackPanel>
                <Border Grid.ColumnSpan="3" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource BarLine}" />
            </Grid>

            <Grid Grid.Row="1">
                <wv2:WebView2 x:Name="Web" />
                <!-- заставка: знак, название, спокойный индикатор загрузки; ошибки — читаемым блоком с кнопкой -->
                <Border x:Name="Splash" Background="{DynamicResource BarBg}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                        <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                                HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#8B5CF6" BlurRadius="30" ShadowDepth="0" Opacity="0.45" />
                            </Border.Effect>
                            <TextBlock Text="B1" FontFamily="Cascadia Mono, Consolas" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Beg1nnnerOS" Margin="0,18,0,0" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BarFg}" HorizontalAlignment="Center" />
                        <Border x:Name="Loading" Width="120" Height="3" CornerRadius="2" Margin="0,18,0,0" ClipToBounds="True" Background="{DynamicResource BarLine}"
                                HorizontalAlignment="Center">
                            <Border Width="60" Height="3" CornerRadius="2" Background="{DynamicResource Accent}" HorizontalAlignment="Left">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="LoadingSlide" X="-60" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <TextBlock x:Name="SplashText" Text="Запуск…" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="{DynamicResource BarMuted}"
                                   Margin="0,14,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                        <Border x:Name="ErrorBox" Visibility="Collapsed" Margin="0,20,0,0" Padding="18,16" CornerRadius="14" Background="#14FB7185" BorderBrush="#4DFB7185"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="ErrorText" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="{DynamicResource BarFg}"
                                           TextWrapping="Wrap" LineHeight="19" />
                                <Button x:Name="ErrorButton" Margin="0,14,0,0" HorizontalAlignment="Left" Cursor="Hand" Click="OnErrorButton">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{DynamicResource Accent}" CornerRadius="10" Padding="16,9">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#C4B5FD" />
                                                    <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock x:Name="ErrorButtonText" Text="Открыть страницу загрузки" Foreground="White" FontWeight="SemiBold"
                                               FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
